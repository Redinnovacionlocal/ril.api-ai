FROM golang:1.25-alpine AS builder

WORKDIR /app

COPY . .

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
     go build -mod=mod -o sandbox ./cmd/sandbox

FROM gcr.io/distroless/base-debian12

WORKDIR /app
COPY --from=builder /app/sandbox /app/sandbox

ENV PORT=8080
EXPOSE 8080

USER nonroot:nonroot
CMD ["/app/sandbox", "web", "-port", "8080", "api", "-webui_address", "127.0.0.1:8081", "webui", "--api_server_address", "http://127.0.0.1:8081/api"]
